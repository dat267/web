# Credentials — never commit
.env
.env.*
!.env.example

# Runtime state: cookie jars, cached tokens, cached name maps (0700, created
# lazily by the scripts). Anything in here is credential material.
tmp/
*.b64

# Browser profiles (contain authenticated cookies and storage)
.chrome-profile/
.slack-profile/
.owa-profile/
.claude/settings.local.json

# Harness output
.playwright-output/
*.log

# Runtime
node_modules/
